{
  "format_version": 1,
  "issues": [
    {
      "id": "integer-enum-null-member",
      "issue": 4819,
      "effect": "import-error",
      "when": {
        "all": [
          {
            "any": [
              {
                "all": [
                  {
                    "signal": "integer_enums_with_null",
                    "op": ">=",
                    "value": 1
                  },
                  {
                    "any": [
                      {
                        "config": "use_specialized_enum",
                        "op": "==",
                        "value": true
                      },
                      {
                        "config": "use_subclass_enum",
                        "op": "==",
                        "value": true
                      }
                    ]
                  }
                ]
              },
              {
                "all": [
                  {
                    "signal": "number_enums_with_null",
                    "op": ">=",
                    "value": 1
                  },
                  {
                    "config": "use_subclass_enum",
                    "op": "==",
                    "value": true
                  }
                ]
              }
            ]
          },
          {
            "config": "enum_field_as_literal",
            "op": "!=",
            "value": "all"
          },
          {
            "not": {
              "all": [
                {
                  "config": "output_model_type",
                  "op": "==",
                  "value": "msgspec.Struct"
                },
                {
                  "config": "use_msgspec_nullable_enum_alias",
                  "op": "==",
                  "value": true
                }
              ]
            }
          }
        ]
      },
      "workarounds": [
        {
          "when": {
            "config": "output_model_type",
            "op": "==",
            "value": "msgspec.Struct"
          },
          "set": {
            "use_msgspec_nullable_enum_alias": true
          }
        },
        {
          "set": {
            "enum_field_as_literal": "all"
          }
        }
      ],
      "message": "An integer or number enum that lists null becomes an IntEnum or a value-typed Enum with a None member, which fails at import (integer enums with null: {integer_enums_with_null}, number enums: {number_enums_with_null}).",
      "repro": {
        "input": "4819.json",
        "args": [
          "--input-file-type",
          "jsonschema",
          "--output-model-type",
          "pydantic_v2.BaseModel",
          "--preset",
          "standard-py314-20261017"
        ],
        "shows": "integer_none = None"
      }
    },
    {
      "id": "collapse-root-models-stale-module-import",
      "issue": 4821,
      "effect": "import-error",
      "when": {
        "all": [
          {
            "config": "collapse_root_models",
            "op": "==",
            "value": true
          },
          {
            "config": "treat_dot_as_module",
            "op": "!=",
            "value": false
          },
          {
            "signal": "module_imports_named_like_fields",
            "op": ">=",
            "value": 1
          }
        ]
      },
      "workarounds": [
        {
          "set": {
            "collapse_root_models": false
          }
        }
      ],
      "message": "A module that imports a dotted-key module of root models only, and has a field with that module's name, keeps the import after --collapse-root-models writes the root models in place and drops the module, so the package fails to import (modules: {module_imports_named_like_fields}).",
      "repro": {
        "input": "4821.yaml",
        "args": [
          "--input-file-type",
          "openapi",
          "--output-model-type",
          "pydantic_v2.BaseModel",
          "--preset",
          "standard-py314-20261017"
        ],
        "output": "models",
        "file": "models/core/v1.py",
        "shows": "import resource as resource_1"
      }
    },
    {
      "id": "full-path-dotted-cycle-import",
      "issue": 4823,
      "effect": "import-error",
      "when": {
        "all": [
          {
            "config": "naming_strategy",
            "op": "in",
            "value": [
              "full-path",
              "parent-prefixed"
            ]
          },
          {
            "config": "treat_dot_as_module",
            "op": "!=",
            "value": false
          },
          {
            "signal": "inline_models_in_dotted_cycles",
            "op": ">=",
            "value": 1
          }
        ]
      },
      "workarounds": [
        {
          "set": {
            "treat_dot_as_module": false
          }
        }
      ],
      "message": "With --naming-strategy full-path or parent-prefixed, inline models of dotted-key schemas whose modules reference each other in a cycle move to a module of their own, and the package fails to import (inline models: {inline_models_in_dotted_cycles}).",
      "repro": {
        "input": "4823.yaml",
        "args": [
          "--input-file-type",
          "openapi",
          "--output-model-type",
          "pydantic_v2.BaseModel",
          "--preset",
          "standard-py314-20261017",
          "--naming-strategy",
          "full-path"
        ],
        "output": "models",
        "file": "models/_internal.py",
        "shows": "from .treasury import TransactionEntryTreasury"
      }
    },
