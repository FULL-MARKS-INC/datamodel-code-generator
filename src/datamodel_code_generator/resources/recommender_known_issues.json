              {
                "all": [
                  {
                    "signal": "optional_enum_discriminator_tags",
                    "op": ">=",
                    "value": 1
                  },
                  {
                    "config": "enum_field_as_literal",
                    "op": "in",
                    "value": [
                      "one",
                      "all"
