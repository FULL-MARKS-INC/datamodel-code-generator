              },
              {
                "signal": "defaulted_enum_discriminator_tags",
                "op": "==",
                "value": 0
              }
            ]
          },
          "set": {
            "enum_field_as_literal": "none"
          }
        }
      ],
      "message": "A discriminator property that is a single-value enum or const without a default and not required becomes an optional Literal, so pydantic rejects the union at import; Enum classes avoid it for enum tags while no enum tag has a default (enum tags: {optional_enum_discriminator_tags}, const tags: {optional_const_discriminator_tags}, enum tags with a default: {defaulted_enum_discriminator_tags}).",
      "repro": {
